HOST=127.0.0.1
PORT=8787
TOKEN_TTL_SECONDS=300
TOKEN_SIGNING_KEY=replace-with-long-random-secret
PASSPHRASE_HASH=replace-with-base64url-sha256
COOKIE_SECURE=true
COOKIE_DOMAIN=musut.beer
PROTECTED_ORIGIN=http://127.0.0.1:8081

# Path to the guestbook JSON database. In production, point this at a shared
# (non-release) path so entries survive deploys, e.g.:
# GUESTBOOK_DB_PATH=/opt/musut-gateway/shared/guestbook.json
GUESTBOOK_DB_PATH=./data/guestbook.json

# Optional Strapi passphrase verification endpoint
# STRAPI_VERIFY_URL=https://cms.example.com/api/passphrase/verify
# STRAPI_VERIFY_TOKEN=replace-with-strapi-token
