HOST=127.0.0.1
PORT=8787
TOKEN_TTL_SECONDS=300
TOKEN_SIGNING_KEY=replace-with-long-random-secret
PASSPHRASE_HASH=replace-with-base64url-sha256
COOKIE_SECURE=true
PROTECTED_ORIGIN=http://127.0.0.1:8081

