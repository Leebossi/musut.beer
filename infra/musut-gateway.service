[Unit]
Description=musut.beer auth gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/musut-gateway/current
EnvironmentFile=/opt/musut-gateway/shared/gateway.env
ExecStart=/usr/bin/env node /opt/musut-gateway/current/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
